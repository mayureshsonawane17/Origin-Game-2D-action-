theme_override_font_sizes/font_size = 7
text = "• MOVE: [A / D] or [Left / Right Arrows] | Gamepad Left Stick
• JUMP: [W] or [Space] | Gamepad (A)
• ATTACK (3-Hit Combo): [J] or [Left Click] | Gamepad (X)
• BLOCK / PARRY: [K] or [Right Click] | Gamepad (LB)
  -> Timed parry (0.15s) negates 100% damage, staggers enemy & counters!
• MAGIC PROJECTILE: [L] or [Q] | Gamepad (Y)
• DODGE ROLL (i-frames): [Shift] or [Space in Air] | Gamepad (B)
• HEAL CHARGES: [H] | Gamepad D-Pad Up
• SWITCH WEAPON: [Q] or [E] | Gamepad D-Pad Down
• INVENTORY & SKILL TREE: [Tab] or [Esc] | Gamepad (Select / Start)"


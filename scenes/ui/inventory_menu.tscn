[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/inventory_menu.gd" id="1_inv"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.06, 0.08, 0.12, 0.94)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.25, 0.35, 0.5, 0.8)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[node name="InventoryMenu" type="CanvasLayer"]
process_mode = 3
layer = 50
script = ExtResource("1_inv")

[node name="PanelContainer" type="PanelContainer" parent="."]
